# Chef Andino - environment variables.
#
# NOTHING here is required for the offline demo (mock planner, local store).
# These are only read when you opt into the real-LLM mode:
#
#     chef run-agent --planner bedrock
#
# which calls Amazon Bedrock from your machine with your AWS credentials
# (and therefore costs real money - see docs/agent-loop.md).

AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-sonnet-5

# Optional CDK deployment context. These values identify infrastructure; they
# are not credentials. Pass them through CDK_ARGS as shown in README.md.
# CDK_ARGS=-c hostname=chef.example.com -c hostedZoneId=Z1234567890 -c hostedZoneName=example.com
